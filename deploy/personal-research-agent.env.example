# Copy outside Git to /etc/personal-research-agent.env, owner root:personalagent, mode 640.
# systemd EnvironmentFile syntax; not a shell script. Replace origin with your real domain.
PERSONAL_AGENT_MODE=server
PERSONAL_AGENT_STORAGE=sqlite
PERSONAL_AGENT_DATA_DIR=/var/lib/personal-research-agent
PERSONAL_AGENT_DATABASE=/var/lib/personal-research-agent/workspace.sqlite
PERSONAL_AGENT_PUBLIC_ORIGIN=https://agent.example.invalid
PERSONAL_AGENT_LISTEN_HOST=127.0.0.1
PERSONAL_AGENT_TRUSTED_PROXIES=127.0.0.1
PERSONAL_AGENT_PORT=4317
PERSONAL_AGENT_BACKUP_DIR=/var/backups/personal-research-agent
# Optional Ask configuration: use a real cloud service or a separately managed loopback proxy.
# PERSONAL_AGENT_MODEL_BASE_URL=https://your-model-service.invalid/v1
# PERSONAL_AGENT_MODEL=gpt-6-luna
# PERSONAL_AGENT_DAILY_ASK_LIMIT=50
# PERSONAL_AGENT_MODEL_KEY_FILE=/etc/personal-research-agent-model-key
# Alternative to KEY_FILE: PERSONAL_AGENT_MODEL_KEY=REPLACE_IN_PRIVATE_FILE_ONLY
# UI-only keys stay in process memory; environment keys apply only to the matching configured base URL.
# ThinkFlow uses the separately managed same-host loopback service on 8437.
